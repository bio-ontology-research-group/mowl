Prefix(:=<http://mowl.borg/compat/rich#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Ontology(<http://mowl.borg/compat/rich> <http://mowl.borg/compat/rich/1.0>
Annotation(rdfs:comment "An ontology that uses constructs beyond EL.")
Declaration(Class(:Person))
Declaration(Class(:Man))
Declaration(Class(:Woman))
Declaration(Class(:Parent))
Declaration(Class(:Mother))
Declaration(Class(:Father))
Declaration(Class(:Childless))
Declaration(Class(:Pet))
Declaration(Class(:Dog))
Declaration(Class(:Cat))
Declaration(Class(:PetOwner))
Declaration(Class(:DogOnlyOwner))
Declaration(Class(:BusyParent))
Declaration(Class(:Weekday))
Declaration(Class(:Adult))
Declaration(Class(obo:GO_0000001))
Declaration(Class(obo:GO_0000002))
Declaration(ObjectProperty(:hasChild))
Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasPet))
Declaration(ObjectProperty(:knows))
Declaration(ObjectProperty(:hasAncestor))
Declaration(ObjectProperty(:hasSpouse))
Declaration(ObjectProperty(:hasMother))
Declaration(DataProperty(:hasAge))
Declaration(DataProperty(:hasName))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(NamedIndividual(:anna))
Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:carl))
Declaration(NamedIndividual(:rex))
Declaration(NamedIndividual(:monday))
Declaration(NamedIndividual(:tuesday))
AnnotationAssertion(rdfs:label :Person "person"@en)
AnnotationAssertion(rdfs:label :Parent "parent")
AnnotationAssertion(obo:IAO_0000115 :Parent "A person who has at least one child.")
AnnotationAssertion(rdfs:label obo:GO_0000001 "mitochondrion inheritance")
AnnotationAssertion(rdfs:label obo:GO_0000002 "mitochondrial genome maintenance"^^xsd:string)
AnnotationAssertion(rdfs:seeAlso :Dog <http://example.org/dog>)
AnnotationAssertion(rdfs:label :anna "Anna")
SubClassOf(:Man :Person)
SubClassOf(:Woman :Person)
DisjointClasses(:Man :Woman)
DisjointUnion(:Pet :Dog :Cat)
EquivalentClasses(:Parent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasChild :Person)))
EquivalentClasses(:Mother ObjectIntersectionOf(:Woman :Parent))
EquivalentClasses(:Father ObjectIntersectionOf(:Man :Parent))
EquivalentClasses(:Childless ObjectIntersectionOf(:Person ObjectComplementOf(:Parent)))
EquivalentClasses(:PetOwner ObjectSomeValuesFrom(:hasPet :Pet))
EquivalentClasses(:DogOnlyOwner ObjectIntersectionOf(:PetOwner ObjectAllValuesFrom(:hasPet :Dog)))
EquivalentClasses(:BusyParent ObjectIntersectionOf(:Person ObjectMinCardinality(3 :hasChild :Person)))
EquivalentClasses(:Weekday ObjectOneOf(:monday :tuesday))
EquivalentClasses(:Adult ObjectIntersectionOf(:Person DataSomeValuesFrom(:hasAge DatatypeRestriction(xsd:integer xsd:minInclusive "18"^^xsd:integer))))
SubClassOf(:Person ObjectMaxCardinality(1 :hasMother))
SubClassOf(:Person ObjectUnionOf(:Man :Woman))
SubClassOf(obo:GO_0000002 obo:GO_0000001)
SubClassOf(:Dog ObjectHasValue(:knows :rex))
SubClassOf(:Person ObjectExactCardinality(2 :hasParent))
SubClassOf(:PetOwner ObjectHasSelf(:knows))
InverseObjectProperties(:hasChild :hasParent)
SubObjectPropertyOf(:hasParent :hasAncestor)
SubObjectPropertyOf(:hasMother :hasParent)
TransitiveObjectProperty(:hasAncestor)
SymmetricObjectProperty(:hasSpouse)
FunctionalObjectProperty(:hasMother)
IrreflexiveObjectProperty(:hasParent)
AsymmetricObjectProperty(:hasParent)
ReflexiveObjectProperty(:knows)
InverseFunctionalObjectProperty(:hasSpouse)
ObjectPropertyDomain(:hasPet :Person)
ObjectPropertyRange(:hasPet :Pet)
SubObjectPropertyOf(ObjectPropertyChain(:hasParent :hasParent) :hasAncestor)
FunctionalDataProperty(:hasAge)
DataPropertyDomain(:hasAge :Person)
DataPropertyRange(:hasAge xsd:integer)
ClassAssertion(:Woman :anna)
ClassAssertion(:Man :bob)
ClassAssertion(:Person :carl)
ClassAssertion(:Dog :rex)
ObjectPropertyAssertion(:hasChild :anna :carl)
ObjectPropertyAssertion(:hasChild :bob :carl)
ObjectPropertyAssertion(:hasPet :carl :rex)
ObjectPropertyAssertion(:hasSpouse :anna :bob)
NegativeObjectPropertyAssertion(:hasPet :anna :rex)
DataPropertyAssertion(:hasAge :anna "41"^^xsd:integer)
DataPropertyAssertion(:hasAge :carl "12"^^xsd:integer)
DataPropertyAssertion(:hasName :anna "Anna")
DifferentIndividuals(:anna :bob :carl)
)
