Prefix(:=<http://mowl.borg/compat/el#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://mowl.borg/compat/el>
Declaration(Class(:Animal))
Declaration(Class(:Plant))
Declaration(Class(:Herbivore))
Declaration(Class(:Carnivore))
Declaration(Class(:Cow))
Declaration(Class(:Lion))
Declaration(Class(:Grass))
Declaration(Class(:MadCow))
Declaration(Class(:Organ))
Declaration(Class(:Heart))
Declaration(Class(:Ventricle))
Declaration(Class(:Unused))
Declaration(ObjectProperty(:eats))
Declaration(ObjectProperty(:hasPart))
Declaration(ObjectProperty(:hasDirectPart))
Declaration(ObjectProperty(:partOf))
Declaration(ObjectProperty(:feedsOn))
Declaration(NamedIndividual(:daisy))
Declaration(NamedIndividual(:leo))
Declaration(NamedIndividual(:lawn))
AnnotationAssertion(rdfs:label :Animal "animal"@en)
AnnotationAssertion(rdfs:label :Cow "cow"@en)
AnnotationAssertion(rdfs:label :Cow "Kuh"@de)
AnnotationAssertion(rdfs:comment :Cow "A cow eats
grass.")
AnnotationAssertion(rdfs:label :Lion "lion")
AnnotationAssertion(rdfs:label :eats "eats")
SubClassOf(:Herbivore :Animal)
SubClassOf(:Carnivore :Animal)
SubClassOf(:Cow :Herbivore)
SubClassOf(:Lion :Carnivore)
SubClassOf(:Grass :Plant)
SubClassOf(:Cow ObjectSomeValuesFrom(:eats :Grass))
SubClassOf(:Lion ObjectSomeValuesFrom(:eats :Herbivore))
SubClassOf(ObjectSomeValuesFrom(:eats :Plant) :Herbivore)
SubClassOf(ObjectIntersectionOf(:Animal :Plant) owl:Nothing)
EquivalentClasses(:MadCow ObjectIntersectionOf(:Cow ObjectSomeValuesFrom(:eats :Animal)))
SubClassOf(ObjectIntersectionOf(:Herbivore ObjectSomeValuesFrom(:eats :Animal)) owl:Nothing)
SubClassOf(:Heart :Organ)
SubClassOf(:Heart ObjectSomeValuesFrom(:hasDirectPart :Ventricle))
SubClassOf(:Animal ObjectSomeValuesFrom(:hasPart :Heart))
SubClassOf(ObjectSomeValuesFrom(:hasPart ObjectSomeValuesFrom(:hasPart :Ventricle)) ObjectSomeValuesFrom(:hasPart :Organ))
DisjointClasses(:Heart :Ventricle :Grass)
SubObjectPropertyOf(:hasDirectPart :hasPart)
SubObjectPropertyOf(:feedsOn :eats)
SubObjectPropertyOf(ObjectPropertyChain(:hasPart :hasPart) :hasPart)
TransitiveObjectProperty(:partOf)
ObjectPropertyDomain(:eats :Animal)
ClassAssertion(:Cow :daisy)
ClassAssertion(:Lion :leo)
ClassAssertion(:Grass :lawn)
ObjectPropertyAssertion(:eats :daisy :lawn)
ObjectPropertyAssertion(:feedsOn :leo :daisy)
)
