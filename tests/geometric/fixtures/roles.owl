    <!-- http://mowl.borg/geo#A -->

    <owl:Class rdf:about="http://mowl.borg/geo#A">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://mowl.borg/geo#r"/>
                <owl:someValuesFrom rdf:resource="http://mowl.borg/geo#B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://mowl.borg/geo#B -->

    <owl:Class rdf:about="http://mowl.borg/geo#B">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://mowl.borg/geo#r"/>
                <owl:someValuesFrom rdf:resource="http://mowl.borg/geo#B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://mowl.borg/geo#C -->

    <owl:Class rdf:about="http://mowl.borg/geo#C"/>
    


    <!-- http://mowl.borg/geo#D -->

