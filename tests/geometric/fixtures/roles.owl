                <owl:onProperty rdf:resource="http://mowl.borg/geo#r"/>
                <owl:someValuesFrom rdf:resource="http://mowl.borg/geo#B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://mowl.borg/geo#C"/>
            <rdf:Description rdf:about="http://mowl.borg/geo#E"/>
        </owl:intersectionOf>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
    </owl:Class>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://mowl.borg/geo#s"/>
