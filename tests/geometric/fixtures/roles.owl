    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://mowl.borg/geo#t"/>
        <owl:someValuesFrom rdf:resource="http://mowl.borg/geo#B"/>
        <rdfs:subClassOf rdf:resource="http://mowl.borg/geo#D"/>
    </owl:Restriction>
