    <!-- http://mowl.borg/geo#s -->

    <owl:ObjectProperty rdf:about="http://mowl.borg/geo#s"/>
    


    <!-- http://mowl.borg/geo#t -->

    <owl:ObjectProperty rdf:about="http://mowl.borg/geo#t">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://mowl.borg/geo#r"/>
            <rdf:Description rdf:about="http://mowl.borg/geo#s"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


